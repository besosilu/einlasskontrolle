# Datenbank-Passwort (bitte sicheres Passwort wählen)
DB_PASSWORD=change_me_secure_password

# Port auf dem die App erreichbar ist (Standard: 80)
APP_PORT=80

# JWT Secret (bitte langen zufälligen String wählen)
JWT_SECRET=change_me_to_a_long_random_secret

# URL der Anwendung (für Links in E-Mails)
APP_URL=http://localhost

# E-Mail-Adresse des Admins (für Benachrichtigungen bei neuen Registrierungen)
ADMIN_EMAIL=admin@example.com

# SMTP-Konfiguration für E-Mail-Versand
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=smtp_password
SMTP_FROM=Einlassüberwachung <noreply@example.com>
